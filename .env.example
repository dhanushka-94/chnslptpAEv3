# ==============================================================================
# CHANCE LAPTOPS - ENVIRONMENT EXAMPLE
# ==============================================================================
# Copy to `.env` and fill in real values. Never commit `.env`.
# ==============================================================================

APP_NAME="CHANCE LAPTOPS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://chancelaptops.ae

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=chancelaptops_web
DB_USERNAME=chancelaptops_web
DB_PASSWORD=

PRODUCTS_DB_HOST=127.0.0.1
PRODUCTS_DB_PORT=3306
PRODUCTS_DB_DATABASE=chancelaptops_products
PRODUCTS_DB_USERNAME=chancelaptops_products
PRODUCTS_DB_PASSWORD=

WEBXPAY_MODE=sandbox
WEBXPAY_API_USERNAME=
WEBXPAY_API_PASSWORD=
WEBXPAY_SECRET_KEY=
WEBXPAY_PUBLIC_KEY=
WEBXPAY_CHECKOUT_URL="https://stagingxpay.info/index.php?route=checkout/billing"
WEBXPAY_RETURN_URL="${APP_URL}/pay/webxpayResponse"
WEBXPAY_CANCEL_URL="${APP_URL}/payment/webxpay/cancel"
WEBXPAY_NOTIFY_URL="${APP_URL}/payment/webxpay/notify"

KOKOPAY_MODE=sandbox
KOKOPAY_MERCHANT_ID=
KOKOPAY_API_KEY=
KOKOPAY_PRIVATE_KEY=
KOKOPAY_PUBLIC_KEY=
KOKOPAY_PLUGIN_NAME="Chance_Laptops"
KOKOPAY_PLUGIN_VERSION="1"
KOKOPAY_CURRENCY=LKR
KOKOPAY_RETURN_URL="${APP_URL}/payment/kokopay/return"
KOKOPAY_CANCEL_URL="${APP_URL}/payment/kokopay/cancel"
KOKOPAY_NOTIFY_URL="${APP_URL}/payment/kokopay/notify"

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.chancelaptops.ae
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=file
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=mail.chancelaptops.ae
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@chancelaptops.ae"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

PRODUCT_IMAGE_BASE_URL=https://erp.chancelaptops.ae/assets/uploads
WHATSAPP_NUMBER=971522306476
WHATSAPP_DISPLAY="+971 52 230 6476"
